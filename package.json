{
  "name": "bundlers-comparison",
  "version": "1.0.0",
  "license": "'",
  "source": "index.html",
  "scripts": {
    "build:webpack": "webpack --config bundler-configs/webpack.config.js",
    "build:rollup": "rollup -c bundler-configs/rollup.config.mjs",
    "build:esbuild": "esbuild src/index.jsx --legal-comments=none --jsx=automatic --bundle --minify --outfile=dist/esbuild-bundle.js",
    "build:farm": "farm build --config bundler-configs/farm.config.js",
    "build:rspack": "rspack build --config bundler-configs/rspack.config.js",
    "build:parcel": "parcel build",
    "build:snowpack": "snowpack build --config bundler-configs/snowpack.config.js --polyfill-node",
    "build:rolldown": "rolldown -c bundler-configs/rolldown.config.mjs",
    "build:deno_native": "deno bundle src/index.jsx > dist/deno-bundle.js",
    "build:bun_native": "bun build ./src/index.jsx --outfile=dist/bun-bundle.js",
    "build:complex:vite": "vite build --config bundler-configs/vite.excalidraw.config.mjs",
    "build:complex:webpack": "webpack --config bundler-configs/webpack.excalidraw.config.js",
    "build:complex:rollup": "rollup -c bundler-configs/rollup.excalidraw.config.mjs",
    "build:complex:rolldown": "rolldown -c bundler-configs/rolldown.excalidraw.config.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.27.1",
    "@farmfe/cli": "^1.0.4",
    "@farmfe/core": "^1.6.7",
    "@farmfe/plugin-react": "^2.0.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.6",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-loader": "^10.1.1",
    "esbuild": "^0.28.2",
    "parcel": "^2.16.4",
    "rolldown": "^1.2.15",
    "rollup": "^4.66.0",
    "rollup-plugin-terser": "^7.0.2",
    "serve": "^14.2.6",
    "snowpack": "^3.8.8",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.14",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  }
}
